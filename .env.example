# aiida-agents environment configuration
#
# Every knob shares the AIIDA_AGENTS_ prefix, except OLLAMA_BASE_URL and the
# cloud provider SDK keys, which keep their conventional unprefixed names so an
# existing setup works as-is. Copy this file to `.env`, then uncomment and edit
# only the knobs you want to override. Everything is commented out, so an
# unedited copy behaves exactly like running with no `.env` at all. Most lines
# show the built-in default; where showing one would be useless (there is no
# default, it is a secret, or it is a per-user path) the line shows a worked
# example instead, so read the value before uncommenting it.

# --- Model (LLM) ---

# Provider: 'ollama' (local), 'openai', 'anthropic', 'openrouter', or
# 'openai-compatible'. The cloud providers read their key from the environment
# (see the SDK keys below). 'openrouter' is a cloud aggregator (one key for many
# providers); cloud-only.
# AIIDA_AGENTS_PROVIDER=ollama

# Model name (provider-specific), e.g. 'qwen3.5:2b', 'gpt-4o', 'claude-...'.
# AIIDA_AGENTS_MODEL=qwen3.5:2b

# Endpoint for 'openai-compatible' providers (DeepSeek, Together, vLLM, ...).
# Required for that provider, ignored otherwise. No default.
# AIIDA_AGENTS_BASE_URL=https://api.deepseek.com/v1

# API key for an 'openai-compatible' endpoint. Optional for keyless servers
# (a dummy placeholder is used when unset). Never commit a real key.
# AIIDA_AGENTS_API_KEY=

# Cloud provider SDK keys (unprefixed, not AIIDA_AGENTS_*). Read by the settings
# layer and handed to the provider, so they work here in .env or as exported
# environment variables. Set the one your provider needs; never commit a real key.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Max output tokens per response (all providers). Raise if long runs truncate.
# AIIDA_AGENTS_MAX_TOKENS=8192

# Ollama context window (num_ctx), sent per request. Raise if long conversations
# get cut off. Ollama-only; must exceed AIIDA_AGENTS_MAX_TOKENS. Unset = default.
# AIIDA_AGENTS_CONTEXT_LENGTH=16384

# Ollama server endpoint, shared by the chat model and the RAG embeddings.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Agent behaviour ---

# Max consecutive failed attempts at one tool before the run aborts; any
# success resets the count. 0 disables retries entirely.
# AIIDA_AGENTS_TOOL_RETRIES=3

# --- Sandbox (generated code execution) ---

# AiiDA profile that generated code runs against. Must be a disposable copy of
# your storage: `aiida-agents sandbox init` makes one, `sandbox check` proves it
# shares no database and no repository with a real profile. Nothing downstream
# can tell a copy from the real thing, so this setting is the whole boundary
# around your AiiDA data. Outside the database it only narrows: a snippet that
# gets past the import guard can still read files and reach the network.
# AIIDA_AGENTS_SANDBOX_PROFILE=agents-sandbox

# Seconds one generated snippet may run before it is killed. A query over a
# large provenance graph is slow; an accidental `while True` is forever.
# Between 1 and 300. This bounds generated code only: `sandbox init` copies
# your storage and is allowed to take as long as that takes.
# AIIDA_AGENTS_SNIPPET_TIMEOUT=30.0

# --- Interactive REPL ---

# Recent user turns of conversation replayed as context per query. Lower to
# shrink the context window, raise for longer memory.
# AIIDA_AGENTS_HISTORY_MAX_TURNS=10

# Use vi keybindings for REPL line editing instead of the default emacs ones.
# AIIDA_AGENTS_VI_MODE=false

# --- RAG (documentation retrieval) ---

# Embedding backend: 'ollama' or 'sentence-transformers'.
# AIIDA_AGENTS_EMBED_BACKEND=ollama

# Embedding model, used by the 'ollama' backend.
# AIIDA_AGENTS_EMBED_MODEL=mxbai-embed-large

# Seconds to wait for one embedding request. Raise it if `rag build` times out
# on a slow, CPU-only machine; embedding is the slow half of the build.
# AIIDA_AGENTS_EMBED_TIMEOUT=300

# ChromaDB persistence directory. Defaults to a per-user data directory
# (~/.local/share/aiida-agents/vector_db on Linux), so an index built once is
# found no matter which directory you run from. Only set this for a deliberate
# per-project store -- and use an ABSOLUTE path if you do: a relative one
# resolves against the working directory, so the index appears to vanish the
# moment you run the CLI from somewhere else.
# AIIDA_AGENTS_VECTOR_DB_PATH=/absolute/path/to/vector_db

# --- Logging ---

# Process-wide log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# AIIDA_AGENTS_LOG_LEVEL=INFO

# Optional log file, created relative to where you run the command. If set,
# the file receives everything shown on the console plus full tool-call and
# agent-response traces (regardless of AIIDA_AGENTS_LOG_LEVEL).
# AIIDA_AGENTS_LOG_FILE=aiida_agents_debug.log

# --- MCP server ---

# Port for the streamable-http server.
# AIIDA_AGENTS_PORT=8000
